# Ring0 — environment template. Copy to .env (or worker/.dev.vars) and fill in.
# Every key below is read by code; nothing is decorative.

# === Telephony ===
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Public URL where Twilio will POST inbound calls (your Worker URL).
PUBLIC_WORKER_URL=

# === Voice agent (default: Gemini Live; fallback: OpenAI Realtime) ===
# Default is Gemini. Set VOICE_PROVIDER=openai-realtime to swap providers
# without redeploying — same persona prompt, different upstream model.
VOICE_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-flash-3.1-live
OPENAI_REALTIME_MODEL=gpt-realtime-2

# === Post-call intelligence + everything OpenAI-driven ===
# Used by: extraction agent, Most Wanted poster, persona tuner, meta-agent
# (proposes new personas), and the weekly recap (markdown + hero poster).
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2

# === Reactive backend / hosting ===
CONVEX_DEPLOYMENT=
CONVEX_URL=
NEXT_PUBLIC_CONVEX_URL=

# === Meta-agent dry-run flag ===
# Set to "1" to log the persona-author prompt instead of calling GPT-5.5.
# Lets you iterate the prompt without burning tokens.
RING0_META_DRYRUN=
